# Google Gemini API Key (Required for AI responses)
# احصل على المفتاح من Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model Name (Configurable: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, or gemini-3.7-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Port
PORT=3001
